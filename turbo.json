{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json", "$TURBO_ROOT$/tools/oxlint/**"],
      "outputs": []
    },
    "fmt:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts", "$TURBO_ROOT$/.env"],
      "outputs": [],
      "env": ["DATABASE_URL", "SEARCH_LANGUAGE"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "@hippocampe/tools#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**/*.ts",
        "$TURBO_ROOT$/apps/**/package.json",
        "$TURBO_ROOT$/packages/**/*.ts",
        "$TURBO_ROOT$/packages/**/package.json"
      ],
      "outputs": []
    },
    "@hippocampe/tools#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**/*.ts",
        "$TURBO_ROOT$/apps/**/package.json",
        "$TURBO_ROOT$/packages/**/*.ts",
        "$TURBO_ROOT$/packages/**/package.json",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/.githooks/**",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/apps/android/app/src/**",
        "$TURBO_ROOT$/apps/desktop/assets/**"
      ],
      "outputs": [],
      "env": ["DATABASE_URL", "SEARCH_LANGUAGE"],
      "passThroughEnv": ["ANDROID_HOME", "ANDROID_SDK_ROOT", "JAVA_HOME", "GRADLE_USER_HOME"]
    },
    "@hippocampe/server#openapi": {
      "inputs": ["src/openapi.ts", "$TURBO_ROOT$/packages/api/src/**"],
      "outputs": ["$TURBO_ROOT$/packages/api/openapi.json"]
    },
    "@hippocampe/server#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/packages/api/openapi.json",
        "$TURBO_ROOT$/assets/brand/**"
      ],
      "outputs": [],
      "env": ["DATABASE_URL", "SEARCH_LANGUAGE"]
    },
    "@hippocampe/desktop#generate": {
      "dependsOn": ["@hippocampe/server#openapi"],
      "inputs": [
        "crates/api-gen/**",
        "Cargo.toml",
        "Cargo.lock",
        "$TURBO_ROOT$/packages/api/openapi.json"
      ],
      "outputs": ["crates/api/src/types.rs"]
    },
    "@hippocampe/desktop#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/api/openapi.json"],
      "outputs": []
    },
    "@hippocampe/android#generate": {
      "dependsOn": ["@hippocampe/server#openapi"],
      "inputs": ["scripts/types.ts", "$TURBO_ROOT$/packages/api/openapi.json"],
      "outputs": ["app/src/main/kotlin/fr/kristenjestin/hippocampe/api/Types.kt"]
    },
    "@hippocampe/android#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/packages/api/openapi.json"
      ],
      "outputs": [],
      "env": ["ANDROID_HOME", "ANDROID_SDK_ROOT", "JAVA_HOME"],
      "passThroughEnv": ["CI", "GRADLE_USER_HOME"]
    },
    "@hippocampe/android#lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json", "$TURBO_ROOT$/tools/oxlint/**"],
      "outputs": [],
      "env": ["ANDROID_HOME", "ANDROID_SDK_ROOT", "JAVA_HOME"],
      "passThroughEnv": ["CI", "GRADLE_USER_HOME"]
    },
    "@hippocampe/android#build": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["app/build/outputs/apk/debug/**"],
      "env": ["ANDROID_HOME", "ANDROID_SDK_ROOT", "JAVA_HOME"],
      "passThroughEnv": ["CI", "GRADLE_USER_HOME"]
    },
    "@hippocampe/desktop#build": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["target/debug/story", "target/debug/app"]
    }
  }
}
